# ---------------------------------------------------------------------------
# HomeOps - Docker Compose production environment
#
# Copy to .env.prod (git-ignored):
#
#   make env ENV_NAME=prod
#
# Then start the stack:
#
#   docker compose --env-file .env.prod up --build
#
# The app still uses SQLite; the Postgres/Redis services are optional and only
# start with `--profile infra`.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
HOMEOPS_HOME=/app
HOMEOPS_DB_PATH=/app/data/local/homeops.db
HOMEOPS_SEED_DIR=/app/data/seed
HOMEOPS_TIMEZONE=Europe/London
HOMEOPS_EXPIRING_SOON_DAYS=30
HOMEOPS_DEMO_MODE=true

# --- MCP server -----------------------------------------------------------
HOMEOPS_MCP_HOST=0.0.0.0
HOMEOPS_MCP_PORT=8001
HOMEOPS_MCP_PATH=/mcp
HOMEOPS_MCP_URL=http://mcp:8001/mcp

# --- FastAPI application --------------------------------------------------
HOMEOPS_API_HOST=0.0.0.0
HOMEOPS_API_PORT=8000
HOMEOPS_WEB_PORT=3000

# --- Next.js website ------------------------------------------------------
# Baked into the browser bundle at build time; must be reachable from the
# browser, not from inside the container network.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Summary provider -----------------------------------------------------
# "deterministic" (no credentials needed) or "bedrock".
HOMEOPS_SUMMARY_PROVIDER=bedrock
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# AWS credentials are resolved through the standard AWS credential chain
# (AWS profile, environment or instance role). Never store them here.

# --- Optional infrastructure (`docker compose --profile infra`) -----------
# Reserved for the optional Postgres/Redis services. The application currently
# stores all data in SQLite and does not read these yet.
DATABASE_URL=postgresql://homeops:homeops@postgres:5432/homeops
REDIS_URL=redis://redis:6379
