# ---------------------------------------------------------------------------
# HomeOps example configuration
#
# Copy to `.env` and edit locally. `.env` is git-ignored and must never be
# committed. Every value below is a placeholder - no real credentials belong
# in this file.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
# Repository root used to resolve default paths (data/, logs/).
HOMEOPS_HOME=.

# SQLite database file. Relative paths resolve against HOMEOPS_HOME.
HOMEOPS_DB_PATH=data/local/homeops.db

# Directory holding the fictional demo seed data.
HOMEOPS_SEED_DIR=data/seed

# Household timezone used for date-based reminders and warranty maths.
HOMEOPS_TIMEZONE=Europe/London

# Number of days before warranty end that counts as "expiring soon".
HOMEOPS_EXPIRING_SOON_DAYS=30

# Demo mode marks all seeded records as fictional demo data.
HOMEOPS_DEMO_MODE=true

# --- MCP server -----------------------------------------------------------
HOMEOPS_MCP_HOST=127.0.0.1
HOMEOPS_MCP_PORT=8001
HOMEOPS_MCP_PATH=/mcp
# URL the FastAPI orchestrator uses to reach the MCP server.
HOMEOPS_MCP_URL=http://127.0.0.1:8001/mcp

# --- FastAPI application --------------------------------------------------
HOMEOPS_API_HOST=127.0.0.1
HOMEOPS_API_PORT=8000

# --- Frontend -------------------------------------------------------------
HOMEOPS_WEB_PORT=5173
# Base URL the browser uses to reach the FastAPI API.
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Summary provider -----------------------------------------------------
# "deterministic" (default, no credentials needed) or "bedrock".
HOMEOPS_SUMMARY_PROVIDER=deterministic

# --- Optional Amazon Bedrock Runtime (AWS Builder mini-challenge) ----------
# Credentials are NEVER stored here. Use the standard AWS credential chain
# (AWS profile, environment variables or an instance role).
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Vercel AI SDK + OpenRouter (for web simulation AI) -------------------
# Use these if you want the web UI to use Vercel AI SDK with OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
VITE_USE_OPENROUTER=false

# --- Database (Postgres) ---------------------------------------------------
DATABASE_URL=postgresql://homeops:homeops@localhost:5432/homeops
REDIS_URL=redis://localhost:6379

# --- Bedrock (preferred over OpenRouter) ------------------------------------
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
HOMEOPS_SUMMARY_PROVIDER=bedrock
